# Environment Configuration

# Optional: External AI Provider Key for dynamic occasion reasoning
# If left blank, system automatically uses the built-in deterministic reasoning engine.
LLM_API_KEY=

# Server Configuration
PORT=8000
HOST=127.0.0.1

# Embedding and Reranker Models (defaults to fast lightweight models)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
